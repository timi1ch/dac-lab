# Настройки базы данных PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=lab4

# Строка подключения (используется бэкендом)
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@db:5432/lab4

# Секретный ключ для JWT (сгенерируйте свой в продакшене)
SECRET_KEY=super_secret_key_change_me_to_random_string

# Настройки приложения
APP_ENV=development
PORT=8000

# Параметры хэширования (Argon2id) - как требует лабораторная
HASH_SCHEME=argon2
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2