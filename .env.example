POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lab4
DATABASE_URL=postgresql+psycopg2://postgres:change_me@127.0.0.1:5432/lab4
HASH_SCHEME=argon2
SECRET_KEY=development-only-replace-with-random-value
APP_ENV=development
PORT=8000
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
# При локальном запуске используется PostgreSQL на 127.0.0.1:5432.
# Для существующей базы можно задать DATABASE_URL в окружении или этом файле.
